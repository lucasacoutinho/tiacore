{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    ".legacy/**",
    ".tia/**",
    "coverage/**",
    "dist/**",
    "proofs/.lake/**",
    "sdks/python/dist/**"
  ],
  "printWidth": 80,
  "proseWrap": "always",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "overrides": [
    {
      "files": [".github/workflows/*.{yml,yaml}"],
      "options": {
        "printWidth": 160
      }
    }
  ]
}
