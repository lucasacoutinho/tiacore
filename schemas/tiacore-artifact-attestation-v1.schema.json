{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usescherie.github.io/tiacore/schemas/tiacore-artifact-attestation-v1.schema.json",
  "title": "tiacore artifact attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "algorithm", "keyId", "claim", "signature"],
  "properties": {
    "version": { "const": 1 },
    "algorithm": { "const": "Ed25519" },
    "keyId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:@/-]{1,512}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expiresAt",
        "fingerprint",
        "graphSha256",
        "issuedAt",
        "lineage",
        "promoted"
      ],
      "properties": {
        "expiresAt": { "type": "string", "format": "date-time" },
        "fingerprint": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "graphSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "issuedAt": { "type": "string", "format": "date-time" },
        "promoted": { "type": "boolean" },
        "runner": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "lineage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline", "parents", "producedAt", "runId"],
          "properties": {
            "baseline": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sha"],
              "properties": {
                "sha": { "type": "string", "minLength": 1, "maxLength": 8192 },
                "source": { "enum": ["filesystem", "git"] }
              }
            },
            "parents": {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "oneOf": [
                  { "type": "integer" },
                  { "type": "string", "minLength": 1, "maxLength": 8192 }
                ]
              }
            },
            "producedAt": { "type": "string", "format": "date-time" },
            "producer": { "type": "string", "minLength": 1, "maxLength": 8192 },
            "runId": { "type": "string", "minLength": 1, "maxLength": 8192 }
          }
        }
      }
    }
  }
}
