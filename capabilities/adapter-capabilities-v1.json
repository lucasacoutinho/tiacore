{
  "$schema": "../schemas/tiacore-adapter-capabilities-v1.schema.json",
  "contractVersion": 1,
  "adapters": [
    {
      "id": "vitest",
      "entryPoint": "@usescherie/tiacore/vitest",
      "factory": "tia",
      "capabilityLevel": "runtime-tia",
      "selectionGranularity": "test-case",
      "dependencyEvidence": "runtime",
      "cachedOutcomes": true,
      "coverageReconstruction": true,
      "nativeParallelism": true,
      "baselines": ["filesystem", "git"],
      "boundaries": [
        "watch mode and explicit Vitest selection remain Vitest-owned",
        "separate subprocesses require an explicit subprocess ownership mapping"
      ]
    },
    {
      "id": "playwright",
      "entryPoint": "@usescherie/tiacore/playwright",
      "factory": "tia",
      "capabilityLevel": "observed-file-tia",
      "selectionGranularity": "test-file",
      "dependencyEvidence": "runtime-and-static",
      "cachedOutcomes": false,
      "coverageReconstruction": false,
      "nativeParallelism": true,
      "baselines": ["filesystem", "git"],
      "boundaries": [
        "Chromium uses executed source-map ranges while other engines use conservative map-level attribution",
        "backend and external-service code requires explicit framework or subprocess ownership edges"
      ]
    },
    {
      "id": "node-test",
      "entryPoint": "@usescherie/tiacore/node",
      "factory": "tia",
      "capabilityLevel": "runtime-tia",
      "selectionGranularity": "test-case",
      "dependencyEvidence": "runtime",
      "cachedOutcomes": true,
      "coverageReconstruction": false,
      "nativeParallelism": true,
      "baselines": ["filesystem", "git"],
      "boundaries": [
        "Node 22.10 through 22.14 records one aggregate dependency set for the file",
        "dynamic subtests are attributed to their parent execution"
      ]
    },
    {
      "id": "bun-test",
      "entryPoint": "@usescherie/tiacore/bun",
      "factory": "tia",
      "capabilityLevel": "runtime-tia",
      "selectionGranularity": "test-case",
      "dependencyEvidence": "runtime",
      "cachedOutcomes": true,
      "coverageReconstruction": false,
      "nativeParallelism": true,
      "baselines": ["filesystem", "git"],
      "boundaries": [
        "duplicate matching test names in one file are observed together"
      ]
    },
    {
      "id": "k6",
      "entryPoint": "@usescherie/tiacore/k6",
      "factory": "tia",
      "capabilityLevel": "static-impact",
      "selectionGranularity": "profile",
      "dependencyEvidence": "static",
      "cachedOutcomes": false,
      "coverageReconstruction": false,
      "nativeParallelism": false,
      "baselines": ["explicit-changes"],
      "boundaries": [
        "the adapter executes selected profiles but does not replay native results",
        "application code requires explicit capability observations"
      ]
    },
    {
      "id": "maestro",
      "entryPoint": "@usescherie/tiacore/maestro",
      "factory": "tia",
      "capabilityLevel": "static-impact",
      "selectionGranularity": "flow",
      "dependencyEvidence": "static",
      "cachedOutcomes": false,
      "coverageReconstruction": false,
      "nativeParallelism": false,
      "baselines": ["explicit-changes"],
      "boundaries": [
        "the adapter executes selected flows but does not replay native results",
        "application binaries and device state require explicit invalidators"
      ]
    },
    {
      "id": "gradle-junit",
      "entryPoint": "@usescherie/tiacore/gradle",
      "factory": "tia",
      "capabilityLevel": "static-impact",
      "selectionGranularity": "test-file",
      "dependencyEvidence": "static",
      "cachedOutcomes": false,
      "coverageReconstruction": false,
      "nativeParallelism": true,
      "baselines": ["explicit-changes"],
      "boundaries": [
        "the adapter follows local Java and Kotlin imports and validates selected classes against JUnit XML",
        "Gradle owns workers, forks, task caching, and device execution"
      ]
    },
    {
      "id": "pytest",
      "entryPoint": "python:tiacore",
      "factory": "tia",
      "capabilityLevel": "static-impact",
      "selectionGranularity": "test-file",
      "dependencyEvidence": "static",
      "cachedOutcomes": false,
      "coverageReconstruction": false,
      "nativeParallelism": false,
      "baselines": ["filesystem", "explicit-changes"],
      "boundaries": [
        "the adapter follows local Python imports but does not claim runtime dependency evidence",
        "pytest outcomes and coverage are not replayed"
      ]
    },
    {
      "id": "go-test",
      "entryPoint": "go:github.com/usescherie/tiacore/sdks/go",
      "factory": "New",
      "capabilityLevel": "static-impact",
      "selectionGranularity": "test-file",
      "dependencyEvidence": "static",
      "cachedOutcomes": false,
      "coverageReconstruction": false,
      "nativeParallelism": true,
      "baselines": ["filesystem"],
      "boundaries": [
        "the adapter maps each Go test file and compile-only package to transitive local package inputs, then delegates unique affected packages to go test",
        "Go executes every test in a selected package because the native runner does not accept test-file paths",
        "the Go build and test cache remains runner-owned; tiacore does not persist or replay native Go outcomes"
      ]
    }
  ]
}
