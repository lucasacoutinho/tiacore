{
  "name": "tiajs",
  "version": "0.1.0",
  "description": "Coverage-driven test impact analysis for Vitest, node:test, and bun:test",
  "author": "Lucas Coutinho",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "keywords": [
    "vitest",
    "bun",
    "node-test",
    "test-impact-analysis",
    "tia",
    "testing",
    "coverage"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "import": "./dist/bun.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/vitest/setup.js"
  ],
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "scripts": {
    "benchmark:parallel": "npm run build && vitest bench --run --config vitest.benchmark.config.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run test",
    "check:package": "npm run build && publint && attw --pack . --profile esm-only",
    "check:vcs": "npm run build && git diff --exit-code -- dist",
    "prepack": "npm run build",
    "release:check": "npm run check && npm run check:vcs && npm run check:package && npm audit --omit=dev && npm pack --dry-run",
    "test": "npm run build && vitest run",
    "test:cross-platform": "npm run build && vitest run test/paths.test.ts test/state.test.ts test/coverage.test.ts test/merge.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "picomatch": "^4.0.3",
    "tinyglobby": "^0.2.17"
  },
  "peerDependencies": {
    "vite": ">=6.0.0 <9.0.0",
    "vitest": ">=4.1.0 <5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/react": "^16.3.2",
    "@types/istanbul-lib-instrument": "^1.7.8",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-reports": "^3.0.4",
    "@types/node": "^24.0.0",
    "@types/picomatch": "^4.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "ejs": "^6.0.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.0",
    "publint": "^0.3.22",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
