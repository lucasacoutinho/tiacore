{
  "name": "@usescherie/tiacore",
  "version": "0.2.0",
  "description": "Runner-neutral test impact analysis with JavaScript, Maestro, and k6 adapters",
  "author": "Lucas Coutinho",
  "private": false,
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/usescherie/tiajs.git"
  },
  "homepage": "https://github.com/usescherie/tiajs#readme",
  "bugs": {
    "url": "https://github.com/usescherie/tiajs/issues"
  },
  "keywords": [
    "vitest",
    "playwright",
    "bun",
    "node-test",
    "test-impact-analysis",
    "tia",
    "testing",
    "coverage"
  ],
  "files": [
    "dist",
    "schemas",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./protocol": {
      "import": {
        "types": "./dist/protocol.d.ts",
        "default": "./dist/protocol.js"
      },
      "require": {
        "types": "./dist/protocol.d.cts",
        "default": "./dist/protocol.cjs"
      }
    },
    "./maestro": {
      "import": {
        "types": "./dist/maestro.d.ts",
        "default": "./dist/maestro.js"
      },
      "require": {
        "types": "./dist/maestro.d.cts",
        "default": "./dist/maestro.cjs"
      }
    },
    "./k6": {
      "import": {
        "types": "./dist/k6.d.ts",
        "default": "./dist/k6.js"
      },
      "require": {
        "types": "./dist/k6.d.cts",
        "default": "./dist/k6.cjs"
      }
    },
    "./bun": {
      "import": {
        "types": "./dist/bun.d.ts",
        "default": "./dist/bun.js"
      },
      "require": {
        "types": "./dist/bun.d.cts",
        "default": "./dist/bun.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./playwright": {
      "import": {
        "types": "./dist/playwright.d.ts",
        "default": "./dist/playwright.js"
      },
      "require": {
        "types": "./dist/playwright.d.cts",
        "default": "./dist/playwright.cjs"
      }
    },
    "./playwright/reporter": {
      "import": {
        "types": "./dist/playwright/reporter.d.ts",
        "default": "./dist/playwright/reporter.js"
      },
      "require": {
        "types": "./dist/playwright-reporter.d.cts",
        "default": "./dist/playwright-reporter.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tiacore": "dist/cli.js"
  },
  "sideEffects": [
    "./dist/vitest/setup.js"
  ],
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "scripts": {
    "benchmark:parallel": "npm run build && vitest bench --run --config vitest.benchmark.config.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node config/build-cjs.mjs",
    "check": "npm run typecheck && npm run test",
    "check:package": "npm run build && publint && attw --pack . --profile node16",
    "prepare": "npm run build",
    "publish:private": "node config/publish-private.mjs",
    "release:check": "npm run check && npm run check:package && npm audit --omit=dev && npm pack --dry-run",
    "test": "npm run build && vitest run",
    "test:cross-platform": "npm run build && vitest run test/paths.test.ts test/state.test.ts test/coverage.test.ts test/merge.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "es-module-lexer": "^2.3.1",
    "fflate": "^0.8.3",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "picomatch": "^4.0.3",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.46.0 <2.0.0",
    "vite": ">=6.0.0 <9.0.0",
    "vitest": ">=4.1.0 <5.0.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@playwright/test": "^1.62.0",
    "@testing-library/react": "^16.3.2",
    "@types/istanbul-lib-instrument": "^1.7.8",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-reports": "^3.0.4",
    "@types/node": "^24.0.0",
    "@types/picomatch": "^4.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "ejs": "^6.0.1",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.0",
    "publint": "^0.3.22",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
