        "types": "./dist/entries/evidence.d.ts",
        "default": "./dist/entries/evidence.js"
      },
      "require": {
        "types": "./dist/entries/evidence.d.cts",
        "default": "./dist/entries/evidence.cjs"
      }
    },
    "./protocol": {
