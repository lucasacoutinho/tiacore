  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "benchmark:parallel": "npm run build && vitest bench --run --config vitest.benchmark.config.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node config/build-cjs.mjs",
    "build:python": "node -e \"require('node:fs').rmSync('sdks/python/dist',{recursive:true,force:true})\" && uv build --out-dir sdks/python/dist sdks/python",
    "check": "npm run fmt:check && npm run lint && npm run typecheck && npm run test",
    "check:architecture": "vitest run --config vitest.archer.config.ts",
    "check:go": "npm run test:go && cd sdks/go && go vet ./...",
    "check:python": "npm run test:python && npm run build:python",
    "check:package": "npm run build && publint && attw --pack . --profile node16",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "lint:fix": "oxlint --fix --deny-warnings --report-unused-disable-directives",
    "prepare": "node config/prepare.mjs",
    "release:check": "npm run check && npm run check:package && npm run check:python && npm run check:go && npm audit --omit=dev && npm pack --dry-run",
    "test": "npm run build && vitest run --exclude test/integration/vitest/playwright.integration.test.ts",
    "test:python": "python3 -B -m unittest discover -s sdks/python/tests -v",
    "test:go": "cd sdks/go && go test -count=1 ./...",
    "test:cross-platform": "npm run build && vitest run test/unit/protocol/paths.test.ts test/unit/engine/state.test.ts test/unit/engine/segmented-state.test.ts test/unit/engine/coverage.test.ts test/unit/engine/merge.test.ts test/unit/adapters/playwright-source-maps.test.ts test/unit/adapters/k6.test.ts test/unit/adapters/maestro.test.ts test/unit/adapters/gradle.test.ts test/integration/platform/node-runtime.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-instrument": "^1.7.8",
    "commander": "^14.0.3",
    "es-module-lexer": "^3.0.4",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "picomatch": "^4.0.7",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.9.1"
  },
