{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiacore.dev/schemas/adapter-capabilities-v1.json",
  "title": "tiacore adapter capabilities v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "adapters"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "contractVersion": {
      "const": 1
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/adapter"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "entryPoint",
        "factory",
        "capabilityLevel",
        "selectionGranularity",
        "dependencyEvidence",
        "cachedOutcomes",
        "coverageReconstruction",
        "nativeParallelism",
        "baselines",
        "boundaries"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "entryPoint": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "factory": {
          "type": ["string", "null"]
        },
        "capabilityLevel": {
          "enum": ["runtime-tia", "observed-file-tia", "static-impact"]
        },
        "selectionGranularity": {
          "enum": ["test-case", "test-file", "package", "profile", "flow"]
        },
        "dependencyEvidence": {
          "enum": ["runtime", "runtime-and-static", "static"]
        },
        "cachedOutcomes": {
          "type": "boolean"
        },
        "coverageReconstruction": {
          "type": "boolean"
        },
        "nativeParallelism": {
          "type": "boolean"
        },
        "baselines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["filesystem", "git", "explicit-changes"]
          },
          "uniqueItems": true
        },
        "boundaries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    }
  }
}
